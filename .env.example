# Local development defaults. Replace credentials for your own environment.
TRUSTRAIL_APP_NAME=TrustRail API
TRUSTRAIL_ENVIRONMENT=development
TRUSTRAIL_API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://trustrail:trustrail_dev_only@localhost:5432/trustrail

# Purchase policy (amounts are integer paise; ₹1 = 100 paise)
TRUSTRAIL_MAX_PURCHASE_PAISE=500000
TRUSTRAIL_APPROVAL_THRESHOLD_PAISE=200000
TRUSTRAIL_ALLOWED_MERCHANT_IDS=merchant-123
